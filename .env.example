# ========== NoneBot 基础 ==========
# NoneBot 使用的驱动。FastAPI 用于接收 OneBot 反向 WebSocket 连接。
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080

# OneBot V11 鉴权 Token。请替换为你自己的随机 Token，并与 NapCat 侧保持一致。
ONEBOT_V11_ACCESS_TOKEN=change-this-token

# NoneBot 超级用户和本项目管理员，请替换为你自己的 QQ 号。
# 源码里不写死任何 QQ 号；管理员只从这里读取。
SUPERUSERS=["your_qq_id"]
QQBOT_ADMIN_IDS=your_qq_id

# 指令前缀。
COMMAND_START=["/"]

# ========== 存储 ==========
# SQLite 数据库文件位置。data/ 整个目录不提交到 Git。
QQBOT_DATABASE_PATH=data/qqbot.db

# 表情素材根目录，按情绪分子目录；留空则用 data/stickers。
STICKER_DIR=data/stickers
# 本地缺表情时是否自动后台同步「大肥鱼」表情包。
STICKER_AUTO_FETCH=true

# ========== AI（默认 DeepSeek，OpenAI 兼容接口） ==========
# 留空 DEEPSEEK_API_KEY 即关闭 AI 自动回复。兼容旧的 AI_API_KEY / AI_* 命名。
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=800

# 群聊触发方式：at=只有 @Bot 或回复 Bot 才回复；all=群里每条消息都参与。
AI_GROUP_TRIGGER=at

# 每累计多少条对话做一次记忆摘要压缩。
MEMORY_SUMMARY_EVERY=20

# 图片理解用的视觉模型，留空则退回 DEEPSEEK_* 配置。
VISION_API_KEY=
VISION_API_BASE_URL=
VISION_MODEL=

# ========== 语音 ==========
# 总开关；关闭后所有 [语音] 标签都会被忽略，只发文字。
TTS_ENABLED=true
# edge=微软在线音色（需要联网），sapi=Windows 本地语音（离线可用），off=关闭。
TTS_ENGINE=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
# 单条语音最多合成多少字，超长自动截断。
TTS_MAX_CHARS=180
# edge-tts 失败时是否退回 Windows SAPI。
TTS_SAPI_FALLBACK=true

# ========== 其他功能 ==========
# 违禁词检测，使用英文逗号分隔；留空表示关闭自动检测。
QQBOT_FORBIDDEN_WORDS=
QQBOT_FORBIDDEN_MUTE_SECONDS=60

# B 站视频自动解析限制。
BILIBILI_MAX_MB=50
BILIBILI_MAX_SECONDS=600
